DATABASE_URL="postgresql://crm:crm@localhost:5433/crm?schema=public"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
CLIENT_ORIGIN="http://localhost:5173"

# ---------- Scaling (optional) ----------
# With Redis: shared cache + rate limits across API replicas, a job queue, and the follow-up
# schedule moves to the worker (run `npm run dev:full`). Without it the API runs everything in-process.
# REDIS_URL="redis://localhost:6379"
# Requests per minute per signed-in user
# RATE_LIMIT_PER_MIN=300

# ---------- WhatsApp ----------
# Leave empty to run in "link" mode: messages are logged and a wa.me click-to-chat link is generated.
# Fill these to send automatically via the official WhatsApp Cloud API (Meta).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
# Cron expression for automatic follow-ups (default: every day 10:00)
FOLLOWUP_CRON="0 10 * * *"


