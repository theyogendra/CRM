{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "buildCommand": "npm run build"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "api/index.ts",
      "buildCommand": "npx prisma generate && npx tsc -p tsconfig.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}
